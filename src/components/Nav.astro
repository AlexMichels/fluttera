---
interface Props {
  t: Record<string, any>
  /** Prefix for section anchors: '' on the home page itself, '/' or '/en/' on subpages */
  anchorBase?: string
  homeHref: string
}

const { t, anchorBase = '', homeHref } = Astro.props
const { nav } = t
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a class="nav__brand" href={homeHref} aria-label="Fluttera — Home">Fluttera</a>

    <nav class="nav__menu" id="site-menu" data-menu aria-label={nav.menuLabel}>
      <ul class="nav__list">
        {
          nav.links.map((link: { href: string; label: string }, i: number) => (
            <li>
              <a class="nav__link" href={anchorBase + link.href}>
                <span class="nav__link-index mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary nav__menu-cta" href="https://calendly.com/fluttera/30min" target="_blank" rel="noopener" data-calendly>
        {nav.cta}
      </a>
    </nav>

    <div class="nav__meta">
      <span class="nav__lang mono">
        {
          t.locale === 'de' ? (
            <>
              <span class="nav__lang-current" aria-current="true">DE</span>
              <span class="nav__lang-sep" aria-hidden="true">/</span>
              <a href={nav.langSwitch.href} data-lang-switch aria-label={nav.langSwitch.ariaLabel} lang="en">
                EN
              </a>
            </>
          ) : (
            <>
              <a href={nav.langSwitch.href} data-lang-switch aria-label={nav.langSwitch.ariaLabel} lang="de">
                DE
              </a>
              <span class="nav__lang-sep" aria-hidden="true">/</span>
              <span class="nav__lang-current" aria-current="true">EN</span>
            </>
          )
        }
      </span>
      <a class="btn btn--primary nav__cta" href="https://calendly.com/fluttera/30min" target="_blank" rel="noopener" data-calendly>
        {nav.cta}
      </a>
      <button
        class="nav__burger"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={nav.openMenu}
        data-label-open={nav.openMenu}
        data-label-close={nav.closeMenu}
      >
        <span class="nav__burger-bar" aria-hidden="true"></span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: 4rem;
    background: var(--paper);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .nav.nav--scrolled {
    border-bottom-color: var(--hairline);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 0, 'WONK' 0;
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    line-height: 1;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    list-style: none;
    padding: 0;
    gap: 1.6rem;
  }

  .nav__link {
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding-bottom: 0.3rem;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: auto;
    bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--blue);
    transition: width var(--dur-fast) var(--ease);
  }

  .nav__link:hover::after {
    width: calc(100% + 6px);
  }

  .nav__link-index {
    display: none;
  }

  .nav__menu-cta {
    display: none;
  }

  .nav__meta {
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .nav__lang a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav__lang a:hover {
    color: var(--blue);
  }

  .nav__lang-current {
    color: var(--blue);
    font-weight: 500;
  }

  .nav__lang-sep {
    color: var(--hairline);
    margin-inline: 0.15rem;
  }

  .nav__cta {
    padding: 0.7rem 1.15rem;
    font-size: 0.9375rem;
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin-right: -10px;
  }

  .nav__burger-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }

  /* Dark inversion while a midnight section passes under the nav */
  .nav.nav--dark {
    background: var(--midnight);
    color: var(--paper-on-dark);
    border-bottom-color: var(--hairline-on-dark);
  }

  .nav.nav--dark .nav__link::after {
    background: var(--blue-on-dark);
  }

  .nav.nav--dark .nav__lang a {
    color: var(--soft-on-dark);
  }

  .nav.nav--dark .nav__lang a:hover,
  .nav.nav--dark .nav__lang-current {
    color: var(--blue-on-dark);
  }

  @media (max-width: 61.99rem) {
    .nav__menu {
      position: fixed;
      inset: 4rem 0 0 0;
      background: var(--paper);
      color: var(--ink);
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      padding: clamp(1.5rem, 6vw, 3rem) var(--gutter) 3rem;
      transform: translateY(-105%);
      visibility: hidden;
      transition:
        transform var(--dur-med) var(--ease),
        visibility 0s linear var(--dur-med);
    }

    :global(.nav--open) .nav__menu {
      transform: translateY(0);
      visibility: visible;
      transition:
        transform var(--dur-med) var(--ease),
        visibility 0s;
    }

    .nav__list {
      flex-direction: column;
      gap: 0;
    }

    .nav__list li + li {
      border-top: 1px solid var(--hairline);
    }

    .nav__link {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      font-family: var(--font-display);
      font-optical-sizing: auto;
      font-variation-settings: 'SOFT' 0, 'WONK' 0;
      font-weight: 560;
      font-size: clamp(1.8rem, 6vw, 2.6rem);
      padding-block: 0.9rem;
    }

    .nav__link::after {
      display: none;
    }

    .nav__link-index {
      display: inline;
      color: var(--blue);
      font-size: 0.8125rem;
    }

    .nav__menu-cta {
      display: inline-flex;
      margin-top: 2rem;
    }

    .nav__cta {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    :global(.nav--open) .nav__burger-bar:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }

    :global(.nav--open) .nav__burger-bar:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }
</style>
