---
import CalendlyCta from './CalendlyCta.astro'

interface Props {
  t: Record<string, any>
  /** Prefix for section anchors: '' on the home page itself, '/' or '/en/' on subpages */
  anchorBase?: string
  homeHref: string
}

const { t, anchorBase = '', homeHref } = Astro.props
const { nav } = t
---

<header class="nav" data-nav data-testid="site-nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={homeHref} aria-label="Fluttera Home">Fluttera</a>

    <nav class="nav__menu" id="site-menu" data-menu aria-label={nav.menuLabel}>
      <ul class="nav__list">
        {
          nav.links.map((link: { href: string; label: string }, i: number) => (
            <li>
              <a class="nav__link" href={anchorBase + link.href}>
                <span class="nav__link-index mono" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__meta">
      <span class="nav__lang mono">
        {
          t.locale === 'de' ? (
            <>
              <span class="nav__lang-current" aria-current="true">DE</span>
              <span class="nav__lang-sep" aria-hidden="true">/</span>
              <a href={nav.langSwitch.href} data-lang-switch data-testid="language-toggle" aria-label={nav.langSwitch.ariaLabel} lang="en">
                EN
              </a>
            </>
          ) : (
            <>
              <a href={nav.langSwitch.href} data-lang-switch data-testid="language-toggle" aria-label={nav.langSwitch.ariaLabel} lang="de">
                DE
              </a>
              <span class="nav__lang-sep" aria-hidden="true">/</span>
              <span class="nav__lang-current" aria-current="true">EN</span>
            </>
          )
        }
      </span>
      <div class="nav__cta-wrap">
        <CalendlyCta label={nav.cta} testId="nav-cta" />
      </div>
      <button
        class="nav__burger"
        type="button"
        data-menu-toggle
        data-testid="menu-toggle"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label={nav.openMenu}
        data-label-open={nav.openMenu}
        data-label-close={nav.closeMenu}
      >
        <span class="nav__burger-bar" aria-hidden="true"></span>
        <span class="nav__burger-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: 4.5rem;
    background: transparent;
    color: #fff;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }

  .nav.nav--scrolled {
    background: rgba(244, 247, 251, 0.96);
    color: var(--ink);
    border-bottom-color: var(--hairline);
    backdrop-filter: blur(12px);
  }

  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.75rem);
  }

  .nav__brand {
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.045em;
    text-decoration: none;
    line-height: 1;
  }

  .nav__menu {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .nav__list {
    display: flex;
    list-style: none;
    padding: 0;
    gap: clamp(1rem, 1.8vw, 2rem);
  }

  .nav__link {
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding-bottom: 0.3rem;
    white-space: nowrap;
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: auto;
    bottom: 0;
    width: 0;
    height: 1.5px;
    background: var(--blue);
    transition: width var(--dur-fast) var(--ease);
  }

  .nav__link:hover::after {
    width: calc(100% + 6px);
  }

  .nav__link-index {
    display: none;
  }

  .nav__meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav__lang a {
    color: rgba(255, 255, 255, 0.66);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }

  .nav__lang a:hover {
    color: #fff;
  }

  .nav__lang-current {
    color: var(--blue);
    font-weight: 500;
  }

  .nav__lang-sep {
    color: rgba(255, 255, 255, 0.34);
    margin-inline: 0.15rem;
  }

  .nav__cta-wrap :global(.btn) {
    padding: 0.75rem 1.2rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .nav:not(.nav--scrolled) .nav__cta-wrap :global(.btn) {
    background: #fff;
    color: var(--ink);
  }

  .nav.nav--scrolled .nav__lang a {
    color: var(--ink-soft);
  }

  .nav.nav--scrolled .nav__lang-current {
    color: var(--blue);
  }

  .nav.nav--scrolled .nav__lang-sep {
    color: var(--hairline);
  }

  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 7px;
    width: 44px;
    height: 44px;
    padding: 10px;
    margin-right: -10px;
  }

  .nav__burger-bar {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--dur-fast) var(--ease);
  }

  /* Dark inversion while a midnight section passes under the nav */
  .nav.nav--dark {
    background: rgba(5, 5, 5, 0.92);
    color: var(--paper-on-dark);
    border-bottom-color: var(--hairline-on-dark);
  }

  .nav.nav--dark:not(.nav--scrolled) {
    background: transparent;
    border-bottom-color: transparent;
  }

  .nav.nav--dark .nav__link::after {
    background: var(--blue-on-dark);
  }

  .nav.nav--dark .nav__lang a {
    color: var(--soft-on-dark);
  }

  .nav.nav--dark .nav__lang a:hover,
  .nav.nav--dark .nav__lang-current {
    color: var(--blue-on-dark);
  }

  @media (min-width: 74rem) {
    .nav__list li:nth-child(n + 5) {
      display: none;
    }
  }

  @media (max-width: 73.99rem) {
    .nav__menu {
      position: fixed;
      inset: 4.5rem 0 0 0;
      background: var(--paper);
      color: var(--ink);
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      padding: clamp(1.5rem, 6vw, 3rem) var(--gutter) 3rem;
      transform: translateY(-105%);
      visibility: hidden;
      transition:
        transform var(--dur-med) var(--ease),
        visibility 0s linear var(--dur-med);
    }

    :global(.nav--open) .nav__menu {
      transform: translateY(0);
      visibility: visible;
      transition:
        transform var(--dur-med) var(--ease),
        visibility 0s;
    }

    .nav__list {
      flex-direction: column;
      gap: 0;
    }

    .nav__list li + li {
      border-top: 1px solid var(--hairline);
    }

    .nav__link {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(1.8rem, 6vw, 2.6rem);
      padding-block: 0.9rem;
    }

    .nav__link::after {
      display: none;
    }

    .nav__link-index {
      display: inline;
      color: var(--blue);
      font-size: 0.8125rem;
    }

    .nav__cta-wrap {
      display: none;
    }

    .nav__burger {
      display: flex;
    }

    :global(.nav--open) .nav__burger-bar:first-child {
      transform: translateY(4.25px) rotate(45deg);
    }

    :global(.nav--open) .nav__burger-bar:last-child {
      transform: translateY(-4.25px) rotate(-45deg);
    }

    :global(html.menu-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 38rem) {
    .nav__lang {
      display: none;
    }

    .nav__inner {
      gap: 1rem;
    }

    .nav__meta {
      margin-left: auto;
    }
  }
</style>
