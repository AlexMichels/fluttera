---
import DeviceMockup from './DeviceMockup.astro'
import { em } from '../i18n/index.mjs'
import { CALENDLY_URL } from '../lib/site.mjs'

interface Props {
  t: Record<string, any>
}

const { t } = Astro.props
const { hero } = t
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__eyebrow mono reveal">{hero.eyebrow}</p>
      <h1 class="hero__headline em-draw reveal" style="--d:80ms" set:html={em(hero.headline)} />
      <p class="hero__sub reveal" style="--d:160ms">{hero.sub}</p>
      <div class="hero__actions reveal" style="--d:240ms">
        <a class="btn btn--primary" href={CALENDLY_URL} target="_blank" rel="noopener" data-calendly>
          {hero.ctaPrimary}
        </a>
        <a class="link-bleed" href="#work">
          {hero.ctaSecondary}
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <span class="avail mono">
          <span class="avail__dot" aria-hidden="true"></span>
          {hero.availability}
        </span>
      </div>
    </div>

    <div class="hero__visual reveal" style="--d:200ms">
      <div class="hero__device">
        <DeviceMockup ui={hero.phoneUi} />
        <div class="hero__badge">
          <span class="hero__badge-title">{hero.badge}</span>
          <span class="hero__badge-platforms mono">{hero.badgePlatforms}</span>
        </div>
      </div>
      <p class="hero__caption mono">{hero.phoneCaption}</p>
    </div>
  </div>
  <div class="container">
    <div class="hero__rule rule-draw"></div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4rem;
    background: var(--paper);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    min-height: calc(100svh - 4rem);
    padding-block: clamp(2.5rem, 6vh, 5rem) 0;
  }

  .hero__content {
    grid-column: 1 / 8;
  }

  .hero__eyebrow {
    color: var(--blue);
    margin-bottom: 1.6rem;
  }

  .hero__headline {
    font-size: var(--text-hero);
    max-width: 11em;
    margin-bottom: 1.8rem;
  }

  .hero__sub {
    font-size: var(--text-lead);
    color: var(--ink-soft);
    max-width: 31em;
    margin-bottom: 2.4rem;
    hyphens: manual;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.8rem;
    row-gap: 1.2rem;
  }

  .hero__visual {
    grid-column: 8 / 13;
    align-self: end;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .hero__device {
    position: relative;
  }

  .hero__badge {
    position: absolute;
    left: clamp(-4.5rem, -6vw, -2rem);
    bottom: 4.2rem;
    background: var(--paper);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-offset-blue);
    padding: 0.8rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    max-width: 15rem;
  }

  .hero__badge-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
  }

  .hero__badge-platforms {
    color: var(--blue);
    font-size: 0.6875rem;
  }

  .hero__caption {
    color: var(--ink-soft);
    text-align: center;
    max-width: 26rem;
    hyphens: none;
  }

  .hero__rule {
    height: 1px;
    background: var(--hairline);
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
  }

  @media (max-width: 63.99rem) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
      padding-top: clamp(2.5rem, 8vw, 4rem);
    }

    .hero__content {
      grid-column: 1;
    }

    .hero__visual {
      grid-column: 1;
      margin-top: clamp(2.5rem, 8vw, 4rem);
      justify-self: center;
    }

    .hero__badge {
      left: auto;
      right: clamp(-3rem, -4vw, -1rem);
    }
  }

  @media (max-width: 30rem) {
    .hero__badge {
      position: static;
      margin-top: 1rem;
      box-shadow: none;
    }

    .hero__device {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
</style>
