---
import CalendlyCta from './CalendlyCta.astro'

interface Props {
  t: Record<string, any>
}

const { t } = Astro.props
const { hero } = t
---

<section class="hero" id="top" data-testid="hero" data-theme="dark">
  <div class="hero__scene" aria-hidden="true">
    <img
      class="hero__image"
      src="/assets/img/fluttera-office-hero.jpg"
      alt=""
      width="3840"
      height="2160"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow mono reveal">{hero.eyebrow}</p>
      <h1 class="hero__headline reveal" style="--d:80ms">{hero.headline}</h1>
      <p class="hero__sub reveal" style="--d:160ms">{hero.sub}</p>
      <div class="hero__actions reveal" style="--d:240ms">
        <CalendlyCta label={hero.ctaPrimary} testId="hero-cta" />
        <a class="btn hero__secondary" href="#work">
          {hero.ctaSecondary}
          <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h9M8 3.5 11.5 7 8 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
      <p class="hero__proof mono reveal" style="--d:300ms">{hero.proof}</p>
    </div>
  </div>

  <a class="hero__scroll mono" href="#services">
    {hero.scrollHint}
    <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    background: #080b18;
    color: #fff;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(3, 6, 16, 0.56);
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    overflow: hidden;
    background: #111a39;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding-top: 7.25rem;
    padding-bottom: 7rem;
  }

  .hero__content {
    width: min(100%, 76rem);
    text-align: center;
  }

  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 3vh, 2.25rem);
    color: rgba(255, 255, 255, 0.78);
    letter-spacing: 0.18em;
  }

  .hero__headline {
    max-width: 11.5em;
    margin-inline: auto;
    font-size: clamp(3.4rem, 7.7vw, 8rem);
    font-weight: 650;
    line-height: 0.91;
    letter-spacing: -0.068em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero__sub {
    max-width: 48rem;
    margin: clamp(1.7rem, 4vh, 2.6rem) auto 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(1.05rem, 1.45vw, 1.25rem);
    line-height: 1.48;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__actions :global(.btn--primary) {
    background: #fff;
    color: #11131b;
  }

  .hero__actions :global(.btn--primary:hover) {
    background: #dce8ff;
    color: #11131b;
  }

  .hero__secondary {
    border: 1px solid rgba(255, 255, 255, 0.58);
    background: rgba(4, 8, 20, 0.28);
    color: #fff;
  }

  .hero__secondary:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .hero__proof {
    margin-top: 1.5rem;
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.72rem;
    letter-spacing: 0.13em;
  }

  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 1.35rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: none;
    transform: translateX(-50%);
  }

  @media (max-width: 48rem) {
    .hero__inner {
      align-items: end;
      padding-top: 8rem;
      padding-bottom: 7.5rem;
    }

    .hero__headline {
      font-size: clamp(3rem, 15vw, 5rem);
      line-height: 0.94;
    }

    .hero__image { object-position: 50% center; }
  }

  @media (max-width: 30rem) {
    .hero__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .hero__actions :global(.btn) {
      width: 100%;
    }

    .hero__proof {
      line-height: 1.6;
    }
  }

</style>
