---
// Hand-built smart-home app UI inside a CSS phone frame — layered HTML/CSS/SVG,
// crisp at any DPI. Purely decorative (the caption next to it carries meaning).
interface Props {
  ui: Record<string, any>
}

const { ui } = Astro.props

const DIAL_CIRC = 163.36 // 2π × r26
const DIAL_FILL = 0.68

const icons: Record<string, string> = {
  bulb: '<circle cx="8" cy="6.5" r="4"/><path d="M6.3 12.7h3.4M7 14.8h2"/>',
  thermo: '<path d="M8 2.2v7"/><circle cx="8" cy="11.8" r="2.6"/>',
  blinds: '<rect x="2.6" y="2.6" width="10.8" height="10.8" rx="1"/><path d="M2.6 5.8h10.8M2.6 9h10.8"/>',
  plug: '<path d="M5.6 2.4v2.8M10.4 2.4v2.8"/><rect x="4" y="5.2" width="8" height="5" rx="1.6"/><path d="M8 10.2v3.2"/>',
}

const iconKeys = ['bulb', 'thermo', 'blinds', 'plug']
---

<div class="phone" aria-hidden="true">
  <div class="phone__screen">
    <div class="p-status">
      <span class="p-time">09:41</span>
      <svg class="p-status-icons" width="34" height="10" viewBox="0 0 34 10" fill="none">
        <path d="M1 7.5h2v2H1zM4.5 5.5h2v4h-2zM8 3.5h2v6H8z" fill="currentColor"></path>
        <path d="M14 6.2a5.4 5.4 0 0 1 7 0M15.8 8a2.9 2.9 0 0 1 3.4 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"></path>
        <rect x="25" y="3" width="7.5" height="5.5" rx="1.4" stroke="currentColor" stroke-width="1"></rect>
        <rect x="26.2" y="4.2" width="4" height="3.1" rx="0.6" fill="currentColor"></rect>
      </svg>
    </div>

    <div class="p-header">
      <span class="p-title">{ui.header}</span>
      <span class="p-avatar">A</span>
    </div>

    <div class="p-scenes">
      {ui.scenes.map((s: string, i: number) => <span class:list={['p-scene', i === 0 && 'p-scene--on']}>{s}</span>)}
    </div>

    <div class="p-temp">
      <div class="p-temp-info">
        <span class="p-temp-room">{ui.tempRoom}</span>
        <span class="p-temp-state">{ui.tempState}</span>
      </div>
      <div class="p-dial">
        <svg viewBox="0 0 64 64" width="64" height="64">
          <circle class="p-dial-track" cx="32" cy="32" r="26"></circle>
          <circle
            class="p-dial-arc"
            cx="32"
            cy="32"
            r="26"
            style={`stroke-dasharray:${DIAL_CIRC};--dial-off:${(DIAL_CIRC * (1 - DIAL_FILL)).toFixed(1)}`}
          ></circle>
        </svg>
        <span class="p-dial-value">{ui.tempValue}<small>{ui.tempUnit}</small></span>
      </div>
    </div>

    <div class="p-grid">
      {
        ui.devices.map((d: { n: string; s: string; on: boolean }, i: number) => (
          <div class:list={['p-tile', d.on && 'p-tile--on', i === 3 && 'p-tile--anim']}>
            <div class="p-tile-top">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" set:html={icons[iconKeys[i]]} />
              <span class="p-toggle">
                <span class="p-toggle-knob" />
              </span>
            </div>
            <span class="p-tile-name">{d.n}</span>
            <span class="p-tile-state">{d.s}</span>
          </div>
        ))
      }
    </div>

    <div class="p-tabs">
      <span class="p-tab p-tab--on">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5 9 3l6 5.5V15H3V8.5Z"></path></svg>
      </span>
      <span class="p-tab">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="5" height="5" rx="1"></rect><rect x="10" y="3" width="5" height="5" rx="1"></rect><rect x="3" y="10" width="5" height="5" rx="1"></rect><rect x="10" y="10" width="5" height="5" rx="1"></rect></svg>
      </span>
      <span class="p-tab">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M4 14V8M9 14V4M14 14v-4"></path></svg>
      </span>
      <span class="p-tab">
        <svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M3 6h12M3 12h12"></path><circle cx="7" cy="6" r="1.7" fill="#fff"></circle><circle cx="11.5" cy="12" r="1.7" fill="#fff"></circle></svg>
      </span>
    </div>
    <div class="p-home"></div>
  </div>
</div>

<style>
  .phone {
    width: min(20.5rem, 82vw);
    border: 1.5px solid var(--ink);
    border-radius: 2.6rem;
    padding: 0.6rem;
    background: var(--paper);
    box-shadow: var(--shadow-offset);
  }

  .phone__screen {
    background: #fff;
    border-radius: 2rem;
    border: 1px solid var(--hairline);
    padding: 0.9rem 1rem 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    font-family: var(--font-body);
    color: var(--ink);
    aspect-ratio: 9 / 16.6;
    overflow: hidden;
  }

  .p-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--ink);
  }

  .p-time {
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  .p-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .p-title {
    font-weight: 600;
    font-size: 1.15rem;
    letter-spacing: -0.01em;
  }

  .p-avatar {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    background: var(--blue);
    color: #fff;
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .p-scenes {
    display: flex;
    gap: 0.4rem;
  }

  .p-scene {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.32rem 0.55rem;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    color: var(--ink-soft);
    white-space: nowrap;
  }

  .p-scene--on {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .p-temp {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    background: var(--blue-wash);
    border-radius: 0.8rem;
    padding: 0.8rem 0.9rem;
  }

  .p-temp-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .p-temp-room {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .p-temp-state {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  .p-dial {
    position: relative;
    flex: none;
    width: 64px;
    height: 64px;
  }

  .p-dial svg {
    transform: rotate(-90deg);
  }

  .p-dial-track,
  .p-dial-arc {
    fill: none;
    stroke-width: 5;
    stroke-linecap: round;
  }

  .p-dial-track {
    stroke: rgba(39, 67, 205, 0.16);
  }

  .p-dial-arc {
    stroke: var(--blue);
    stroke-dashoffset: var(--dial-off);
  }

  :global(html.js) .p-dial-arc {
    stroke-dashoffset: 163.36;
  }

  :global(html.js .revealed) .p-dial-arc {
    stroke-dashoffset: var(--dial-off);
    transition: stroke-dashoffset 900ms var(--ease) 450ms;
  }

  .p-dial-value {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: -0.02em;
  }

  .p-dial-value small {
    font-size: 0.6em;
    font-weight: 500;
    margin-left: 1px;
  }

  .p-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.5rem;
  }

  .p-tile {
    border: 1px solid var(--hairline);
    border-radius: 0.7rem;
    padding: 0.6rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    color: var(--ink-soft);
  }

  .p-tile--on {
    background: rgba(39, 67, 205, 0.07);
    border-color: rgba(39, 67, 205, 0.25);
    color: var(--blue);
  }

  .p-tile-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.35rem;
  }

  .p-toggle {
    width: 1.5rem;
    height: 0.9rem;
    border-radius: 999px;
    background: var(--hairline);
    position: relative;
    flex: none;
  }

  .p-tile--on .p-toggle {
    background: var(--blue);
  }

  .p-toggle-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: calc(0.9rem - 4px);
    height: calc(0.9rem - 4px);
    border-radius: 50%;
    background: #fff;
  }

  .p-tile--on .p-toggle-knob {
    left: auto;
    right: 2px;
  }

  /* The fourth tile's toggle nudges on reveal — a small sign of life */
  :global(html.js .revealed) .p-tile--anim .p-toggle-knob {
    animation: knob-tease 1200ms var(--ease) 1400ms;
  }

  @keyframes knob-tease {
    0%,
    100% {
      transform: translateX(0);
    }
    35%,
    65% {
      transform: translateX(4px);
    }
  }

  .p-tile-name {
    font-weight: 500;
    font-size: 0.74rem;
    color: var(--ink);
  }

  .p-tile--on .p-tile-name {
    color: var(--blue-deep);
  }

  .p-tile-state {
    font-size: 0.62rem;
  }

  .p-tabs {
    margin-top: auto;
    display: flex;
    justify-content: space-around;
    align-items: center;
    padding-top: 0.5rem;
    border-top: 1px solid var(--hairline);
  }

  .p-tab {
    color: var(--ink-soft);
    opacity: 0.55;
    display: grid;
    place-items: center;
  }

  .p-tab--on {
    color: var(--blue);
    opacity: 1;
  }

  .p-home {
    margin-top: 0.55rem;
    align-self: center;
    width: 5rem;
    height: 4px;
    border-radius: 999px;
    background: var(--ink);
    opacity: 0.75;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .p-dial-arc {
      stroke-dashoffset: var(--dial-off);
      transition: none;
    }

    :global(html.js .revealed) .p-tile--anim .p-toggle-knob {
      animation: none;
    }
  }
</style>
